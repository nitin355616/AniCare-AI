# AniCare AI Backend Environment Configuration (SIH 2026)
PROJECT_NAME="AniCare AI — Animal Health & Early-Warning Platform"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true

# MongoDB Configuration
MONGODB_URL="mongodb://127.0.0.1:27017"
DATABASE_NAME="anicare_ai"

# Authentication & JWT Security
# In production, replace with a 64+ char random hex string (e.g., openssl rand -hex 32)
JWT_SECRET_KEY="anicare_ai_jwt_super_secret_key_sih2026_dev_seed"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration (comma-separated allowed origins)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# File Uploads Storage
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_MB=10
